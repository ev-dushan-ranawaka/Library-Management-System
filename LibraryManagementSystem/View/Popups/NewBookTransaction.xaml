<Window x:Class="LibraryManagementSystem.View.Popups.NewBookTransaction"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LibraryManagementSystem.View.Popups"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:dc="clr-namespace:LibraryManagementSystem.ViewModel"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        mc:Ignorable="d"
        Height="570" Width="950" WindowStartupLocation="CenterScreen" WindowStyle="None" AllowsTransparency="True" Background="Transparent">

    <Window.DataContext>
        <dc:TransactionViewModel/>
    </Window.DataContext>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition/>
            <RowDefinition Height="100"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" CornerRadius="20 20 0 0" Background="#8B5DFF">
            <StackPanel>
                <TextBlock Text="New Book Transaction" Style="{StaticResource pagetitle}" Margin="40 20 0 0" FontSize="20" Foreground="White"/>
                <Image Source="/Images/Header/close.png" Name="btn_close" Margin="0 -26 20 0" Style="{StaticResource closeMinimizeButton}">
                    <i:Interaction.Triggers>
                        <i:EventTrigger EventName="MouseUp">
                            <i:InvokeCommandAction Command="{Binding MouseUpCloseCommand, UpdateSourceTrigger=PropertyChanged}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"/>
                        </i:EventTrigger>
                    </i:Interaction.Triggers>
                </Image>
            </StackPanel>
        </Border>

        <Border Background="LightGray" Grid.Row="1">
            <Grid  Margin="40 40 40 10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                </Grid.RowDefinitions>

                <TextBlock x:Name="TxtID"/>

                <!--Search Member and Book-->
                <StackPanel Grid.Row="0" Margin="0 0 0 20" Orientation="Horizontal" HorizontalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBox x:Name="TxtSearchMember" Text="{Binding CurrentMemberInDisplay.MemberID, Mode=TwoWay}" Padding="8" FontSize="15" Background="Transparent" Width="300" Height="40"/>
                        <Button Width="120" Content="Member ID" Style="{StaticResource UpdateSearchButton}" Command="{Binding Path=SearchMemberCommand}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="30 0 0 0">
                        <TextBox x:Name="TxtSearchBook" Padding="8" Text="{Binding CurrentBookInDisplay.BookID, Mode=TwoWay}" FontSize="15" Background="Transparent" Width="300" Height="40"/>
                        <Button Width="120" Content="Book ID" Style="{StaticResource UpdateSearchButton}" Command="{Binding Path=SearchBookCommand}"/>
                    </StackPanel>
                </StackPanel>

                <!--Member Name and Book Name-->
                <StackPanel Grid.Row="1" Margin="0 20 0 20" Orientation="Horizontal">
                    <StackPanel Width="420">
                        <TextBlock Text="Member Name" Style="{StaticResource textblockname}"/>
                        <TextBox x:Name="TxtMemberName" IsReadOnly="True" Text="{Binding Path=CurrentMemberInDisplay.MemberName, Mode=TwoWay}" FontSize="15" Background="LightGray" Style="{StaticResource textbox}"/>
                    </StackPanel>
                    <StackPanel Width="420" Margin="30 0 0 0">
                        <TextBlock Text="Book Name" Style="{StaticResource textblockname}"/>
                        <TextBox x:Name="TxtBookName" IsReadOnly="True" Text="{Binding Path=CurrentBookInDisplay.BookTitle, Mode=TwoWay}" FontSize="15" Background="LightGray" Style="{StaticResource textbox}"/>
                    </StackPanel>
                </StackPanel>

                <!--Borrow Book-->
                <Border Grid.Row="2" Margin="0 20 0 20" HorizontalAlignment="Left">
                    <StackPanel Width="420">
                        <TextBlock Text="Borrow Date" Style="{StaticResource textblockname}"/>
                        <DatePicker Name="dpBorrowDate" SelectedDate="{Binding Path=CurrentTransactionInDisplay.BorrowDate, Mode=TwoWay}" Grid.Row="0" Grid.Column="1" Style="{StaticResource DatePickerStyle}" Background="Transparent" BorderThickness="0" Margin="0 20 0 0"/>
                    </StackPanel>
                </Border>

                <!--Due Date-->
                <Border Grid.Row="3" Margin="0 20 0 20" HorizontalAlignment="Left">
                    <StackPanel Width="420">
                        <TextBlock Text="Due Date" Style="{StaticResource textblockname}"/>
                        <DatePicker Name="dpDueDae" SelectedDate="{Binding Path=CurrentTransactionInDisplay.DueDate, Mode=TwoWay}" Grid.Row="0" Grid.Column="1" Style="{StaticResource DatePickerStyle}" Background="Transparent" BorderThickness="0" Margin="0 20 0 0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Button-->
        <Border Grid.Row="3" CornerRadius="0 0 20 20" Background="LightGray">
            <StackPanel>
                <Button x:Name="new_transaction_btn" Command="{Binding SaveCommand, UpdateSourceTrigger=PropertyChanged}" Content="Transfer Book" Style="{StaticResource loginButton}"/>
            </StackPanel>
        </Border>

    </Grid>
</Window>
