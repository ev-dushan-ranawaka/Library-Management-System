<Window x:Class="LibraryManagementSystem.View.Popups.AddCategoryView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LibraryManagementSystem.View.Popups"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:dc="clr-namespace:LibraryManagementSystem.ViewModel"
        mc:Ignorable="d"
        Height="420" Width="500" WindowStartupLocation="CenterScreen" WindowStyle="None" AllowsTransparency="True" Background="Transparent">

    <Window.DataContext>
        <dc:CategoryViewModel/>
    </Window.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition/>
            <RowDefinition Height="100"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" CornerRadius="20 20 0 0" Background="#8B5DFF">
            <StackPanel>
                <TextBlock Text="Add New Category" Style="{StaticResource pagetitle}" Margin="40 20 0 0" FontSize="20" Foreground="White"/>
                <Image Source="/Images/Header/close.png" Name="btn_close" Margin="0 -26 20 0" Style="{StaticResource closeMinimizeButton}">
                    <i:Interaction.Triggers>
                        <i:EventTrigger EventName="MouseUp">
                            <i:InvokeCommandAction Command="{Binding MouseUpCloseCommand, UpdateSourceTrigger=PropertyChanged}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"/>
                        </i:EventTrigger>
                    </i:Interaction.Triggers>
                </Image>
            </StackPanel>
        </Border>

        <Border Background="LightGray" Grid.Row="1">
            <Grid  Margin="40 40 40 10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                </Grid.RowDefinitions>

                <!--Category Name-->
                <Border Grid.Row="0" Margin="0 0 0 20">
                    <StackPanel>
                        <TextBlock Text="Category Name" Style="{StaticResource textblockname}"/>
                        <TextBox x:Name="TxtName" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" FontSize="15" Background="LightGray" Style="{StaticResource textbox}"/>
                        <Label Content="{Binding ElementName=TxtName, Path=(Validation.Errors)[0].ErrorContent}" Foreground="Red" Margin="0 5 0 0" VerticalAlignment="Top" Padding="0"/>
                    </StackPanel>
                </Border>

                <!--Description-->
                <Border Grid.Row="1" Margin="0 20 0 20">
                    <StackPanel>
                        <TextBlock Text="Description" Style="{StaticResource textblockname}"/>
                        <TextBox x:Name="TxtDescriptionn" Text="{Binding Description, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" FontSize="15" Background="LightGray" Style="{StaticResource textbox}"/>
                        <Label Content="{Binding ElementName=TxtDescriptionn, Path=(Validation.Errors)[0].ErrorContent}" Foreground="Red" Margin="0 5 0 0" VerticalAlignment="Top" Padding="0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Button-->
        <Border Grid.Row="2" CornerRadius="0 0 20 20" Background="LightGray">
            <StackPanel>
                <Button x:Name="add_category_btn" Command="{Binding SubmitCommand}" Content="Add Category" Style="{StaticResource loginButton}"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
