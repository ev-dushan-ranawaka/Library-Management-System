<Window x:Class="LibraryManagementSystem.View.Windows.HomeView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LibraryManagementSystem.View.Windows"
        xmlns:nav="clr-namespace:LibraryManagementSystem.CustomControl"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        mc:Ignorable="d"
        xmlns:dc="clr-namespace:LibraryManagementSystem.ViewModel"
        Title="HomeView" Height="700" Width="1200" WindowStartupLocation="CenterScreen" WindowStyle="None" AllowsTransparency="True" Background="LightGray" Loaded="Window_Loaded">

    <Window.Resources>
        <BlurEffect x:Key="blurEffect" Radius="10"/>
    </Window.Resources>

    <Window.DataContext>
        <dc:HomeViewModel/>
    </Window.DataContext>

    <Grid Name="MainGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <!--Header Section-->
        <Border Grid.ColumnSpan="2" Background="White" Margin="0 0 0 10" CornerRadius="0 0 0 0">
            <StackPanel Background="Transparent" Orientation="Horizontal" HorizontalAlignment="Right">
                <Image Source="\Images\Header\minimize.png" Name="btn_minimize" Margin="0 7 15 0"  Style="{StaticResource closeMinimizeButton}">
                    <i:Interaction.Triggers>
                        <i:EventTrigger EventName="MouseUp">
                            <i:InvokeCommandAction Command="{Binding MouseUpMinimizeCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"/>
                        </i:EventTrigger>
                    </i:Interaction.Triggers>
                </Image>
                <Image Source="\Images\Header\close.png" Name="btn_close" Margin="0 13 15 0" Style="{StaticResource closeMinimizeButton}">
                    <i:Interaction.Triggers>
                        <i:EventTrigger EventName="MouseUp">
                            <i:InvokeCommandAction Command="{Binding MouseUpShutdownCommand}" />
                        </i:EventTrigger>
                    </i:Interaction.Triggers>
                </Image>
            </StackPanel>
        </Border>

        <!--Sidebar Section-->
        <Border Grid.Row="1" CornerRadius="0 60 60 0" Background="#8B5DFF">
            <ListBox x:Name="sidebar" SelectionMode="Single" Margin="0 0 0 0" SelectionChanged="sidebar_SelectionChanged" BorderThickness="0" Background="Transparent">
                <nav:NavButton x:Name="membersButton" Navlink="\View\UserControls\MemberControl.xaml" Margin="3 100 3 3" Padding="6" Text="Members" Icon="M 12 2 C 14.209 2 16 3.791 16 6 C 16 8.209 14.209 10 12 10 C 9.791 10 8 8.209 8 6 C 8 3.791 9.791 2 12 2 Z M 12 12 C 16.418 12 20 13.791 20 16 L 20 18 L 4 18 L 4 16 C 4 13.791 7.582 12 12 12 Z"/>
                <nav:NavButton Navlink="\View\UserControls\BookControl.xaml" Margin="3" Padding="6" Text="Books" Icon="M96 0C43 0 0 43 0 96V416c0 53 43 96 96 96h288c17.7 0 32-14.3 32-32s-14.3-32-32-32h-288c-17.7 0-32-14.3-32-32s14.3-32 32-32h256v64c17.7 0 32-14.3 32-32V96c0-17.7-14.3-32-32-32H96zM128 144c0-8.8 7.2-16 16-16h192c8.8 0 16 7.2 16 16s-7.2 16-16 16H144c-8.8 0-16-7.2-16-16zm16 48h192c8.8 0 16 7.2 16 16s-7.2 16-16 16H144c-8.8 0-16-7.2-16-16s7.2-16 16-16z"/>
                <nav:NavButton Navlink="\View\UserControls\CategoryControl.xaml" Margin="3" Padding="6" Text="Category" Icon="M0 96C0 60.7 28.7 32 64 32l384 0c35.3 0 64 28.7 64 64l0 320c0 35.3-28.7 64-64 64L64 480c-35.3 0-64-28.7-64-64L0 96zm64 0l0 64 64 0 0-64L64 96zm384 0L192 96l0 64 256 0 0-64zM64 224l0 64 64 0 0-64-64 0zm384 0l-256 0 0 64 256 0 0-64zM64 352l0 64 64 0 0-64-64 0zm384 0l-256 0 0 64 256 0 0-64z"/>
                <nav:NavButton Navlink="\View\UserControls\TransactionControl.xaml" Margin="3" Padding="6" Text="Transactions" Icon="M48.5 224L40 224c-13.3 0-24-10.7-24-24L16 72c0-9.7 5.8-18.5 14.8-22.2s19.3-1.7 26.2 5.2L98.6 96.6c87.6-86.5 228.7-86.2 315.8 1c87.5 87.5 87.5 229.3 0 316.8s-229.3 87.5-316.8 0c-12.5-12.5-12.5-32.8 0-45.3s32.8-12.5 45.3 0c62.5 62.5 163.8 62.5 226.3 0s62.5-163.8 0-226.3c-62.2-62.2-162.7-62.5-225.3-1L185 183c6.9 6.9 8.9 17.2 5.2 26.2s-12.5 14.8-22.2 14.8L48.5 224z"/>
            </ListBox>
        </Border>

        <!--Content Section-->
        <Border Grid.Row="1" Grid.Column="1" Background="White" Margin="10 0 0 0" CornerRadius="60 0 0 60">
            <Frame x:Name="navframe" NavigationUIVisibility="Hidden" Background="Transparent">

            </Frame>
        </Border>
    </Grid>
</Window>
